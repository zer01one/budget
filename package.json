		"@capacitor/filesystem": "^8.1.5",
		"@capacitor/local-notifications": "^8.3.1",
		"@capacitor/preferences": "^8.0.1",
		"@capacitor/status-bar": "^8.0.4",
		"@capawesome/capacitor-file-picker": "^8.1.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@phosphor-icons/vue": "^2.2.1",
		"@tauri-apps/plugin-dialog": "^2.8.3",
		"@tauri-apps/plugin-fs": "^2.7.1",
		"@tauri-apps/plugin-store": "^2.5.0",
		"@tauri-apps/plugin-updater": "^2.14.0",
		"@vuepic/vue-datepicker": "^14.0.0",
		"echarts": "^6.1.0",
		"jsqr": "^1.4.0",
		"pinia": "^4.1.0",
		"prettier": "^3.9.10",
		"vue": "^3.5.44",
		"vue-echarts": "^8.3.2",
		"vue-router": "^5.4.0",
		"vue-virtual-scroller": "^3.0.5"
	},
	"devDependencies": {
		"@capacitor/cli": "^8.5.3",
