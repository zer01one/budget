	"type": "module",
	"scripts": {
		"dev": "vite",
		"dev:tauri": "tauri dev",
		"dev:android": "vite --host",
		"build": "vue-tsc -b && vite build",
		"build:tauri": "tauri build",
		"build:android": "npm run build && npx cap sync android",
		"cap:sync": "npx cap sync",
		"cap:open": "npx cap open android",
