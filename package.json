		"happy-dom": "^20.10.6",
		"jiti": "^2.7.0",
		"typescript": "~6.0.2",
		"typescript-eslint": "^8.71.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.5",
		"vue-eslint-parser": "^10.4.1",
		"vue-tsc": "^3.3.13"
