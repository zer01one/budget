{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "Budget",
	"version": "0.1.0",
	"identifier": "io.github.zer01one.budget",
	"build": {
		"frontendDist": "../dist",
		"devUrl": "http://localhost:5173",
		"beforeDevCommand": "npm run dev",
		"beforeBuildCommand": "npm run build"
	},
	"app": {
		"windows": [
			{
				"title": "Budget",
				"width": 1100,
				"height": 700,
				"minWidth": 360,
				"minHeight": 600,
				"resizable": true,
				"fullscreen": false,
				"dragDropEnabled": false
			}
		],
		"security": {
			"csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
		}
	},
	"plugins": {
		"updater": {
			"pubkey": "",
			"endpoints": []
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
	}
}
